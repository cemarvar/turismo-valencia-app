<?xml version="1.0" encoding="utf-8"?>
<!-- Primer plano del icono: el logotipo sobre un disco blanco (como en la pantalla de arranque). Medidas en porcentaje porque
     el lanzador dibuja esta capa a distintos tamaños: sobre un lienzo de 108 dp, disco de 56 dp y logotipo de 50 dp. El
     logotipo (`drawable-nodpi/logo_turismo_valencia.png`) tiene el interior transparente: sin el disco no se leería. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <inset
            android:insetBottom="24.07%"
            android:insetLeft="24.07%"
            android:insetRight="24.07%"
            android:insetTop="24.07%">
            <shape android:shape="oval">
                <solid android:color="@android:color/white" />
            </shape>
        </inset>
    </item>
    <item>
        <inset
            android:drawable="@drawable/logo_turismo_valencia"
            android:insetBottom="26.85%"
            android:insetLeft="26.85%"
            android:insetRight="26.85%"
            android:insetTop="26.85%" />
    </item>
</layer-list>
