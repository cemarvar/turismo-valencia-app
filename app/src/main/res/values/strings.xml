    <!-- ValBot: respuestas de las reglas de la app (sin conexión o sin respuesta del servidor) -->
    <string name="valbot_greeting">¡Hola! Soy ValBot, tu asistente de turismo en Valencia. ¿En qué puedo ayudarte?</string>
    <string-array name="valbot_suggestions">
        <item>¿Qué ver hoy gratis en Valencia?</item>
        <item>Restaurantes de paella cerca</item>
        <item>¿Cómo llego al Jardín del Turia?</item>
        <item>¿Qué hago con niños?</item>
        <item>Planes si llueve</item>
        <item>Valencia en 3 días</item>
    </string-array>
    <string name="valbot_reply_hello">¡Hola! Pregúntame por lugares, eventos, gastronomía o cómo llegar a cualquier sitio.</string>
    <string name="valbot_reply_free">Hoy tienes buenas opciones sin gastar nada. Las más cercanas a ti:</string>
    <string name="valbot_reply_eat">Para una buena paella, la cuna es La Albufera (El Palmar) y la Malvarrosa. En el centro, reserva con antelación y pide leña. Mira estas opciones:</string>
    <string name="valbot_reply_christmas">En Navidad, Valencia se llena de luces, mercados y belenes. Aquí tienes la guía completa:</string>
    <string name="valbot_reply_itinerary">Para organizarte, estas guías te sirven de base:</string>
    <string name="valbot_reply_heritage">La Valencia monumental está en estas guías:</string>
    <string name="valbot_reply_tours">Para tickets y tours, mira estas guías y reserva desde Tickets &amp; Tours:</string>
    <string name="valbot_reply_sports">Valencia es ciudad de deporte: carreras, bici, playa y mucho más.</string>
    <string name="valbot_reply_art">Para exposiciones y arte, empieza por aquí:</string>
    <string name="valbot_reply_contact">Puedes contactar con la oficina de turismo de lunes a viernes de 9:00 a 18:00 en el +34 963 000 000 o en info@valencia.com.</string>
    <string name="valbot_reply_fallas">Las Fallas se celebran del 1 al 19 de marzo. La mascletà es cada día a las 14:00 en la Plaza del Ayuntamiento; llega 30 minutos antes.</string>
    <string name="valbot_reply_beach">Valencia tiene 19,5 km de arena y 8 Banderas Azules. Desde el centro, la L4 te deja en Les Arenes.</string>
    <string name="valbot_reply_kids">Con niños funcionan muy bien el Oceanogràfic y el Jardín del Turia (9 km sin coches, con juegos y bicis).</string>
    <string name="valbot_reply_rain">Si llueve, apunta a los museos: el de Bellas Artes es gratuito y el Oceanogràfic tiene zonas cubiertas.</string>
    <string name="valbot_reply_lodging">Para dormir, el centro histórico es lo más cómodo; Ruzafa tiene más ambiente y la zona playa, primera línea de mar.</string>
    <string name="valbot_reply_eco">Valencia fue Capital Verde Europea 2024. Un buen plan sostenible: Jardín del Turia en bici y paseo en barca eléctrica por la Albufera.</string>
    <string name="valbot_reply_found">Esto es lo que he encontrado:</string>
    <string name="valbot_reply_unknown">No tengo claro eso todavía. Prueba a preguntarme por lugares, eventos, gastronomía, alojamientos o cómo llegar a un sitio. Para dudas concretas, contacta con la oficina de turismo de Valencia.</string>
    <string name="valbot_reply_route">%1$s está a %2$s, unos %3$d min a pie desde tu ubicación. Abre la ficha y pulsa «Cómo llegar» para ver la ruta:</string>
    <string name="valbot_reply_route_ask">¿A qué lugar quieres ir? Dime el nombre y te digo cuánto se tarda andando.</string>

