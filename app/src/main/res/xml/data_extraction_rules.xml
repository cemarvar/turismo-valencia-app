<?xml version="1.0" encoding="utf-8"?>
<!--
   Copia de seguridad en la nube (Google) y traspaso de móvil a móvil en Android 12 o más; en Android 11 o menos se usa
   backup_rules.xml con lo mismo (mantener los dos iguales). Qué se copia y qué se deja fuera, en ese archivo.
   La copia en la nube solo se hace si el móvil puede cifrarla de extremo a extremo con el bloqueo de pantalla
   (disableIfNoEncryptionCapabilities): lleva el correo de las reservas y el identificador del móvil.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="osmdroid" />
        <exclude domain="sharedpref" path="osmdroid.xml" />
        <exclude domain="file" path="profileInstalled" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="osmdroid" />
        <exclude domain="sharedpref" path="osmdroid.xml" />
        <exclude domain="file" path="profileInstalled" />
    </device-transfer>
</data-extraction-rules>
